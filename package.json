{
  "name": "aquawindow",
  "private": true,
  "version": "0.2.0",
  "description": "AquaWindow — a pseudo-OS research testbed for agent-negotiated fluid window layout",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx server/index.ts --serve-dist",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/adaptive-e2e.mjs",
    "test:embodied": "node scripts/embodied-e2e.mjs",
    "test:fluid": "node scripts/fluid-e2e.mjs",
    "test:render": "node scripts/render-performance-e2e.mjs",
    "test:compositor": "node scripts/compositor-performance.mjs",
    "test:capsule": "node scripts/capsule-e2e.mjs",
    "test:keys": "node scripts/key-e2e.mjs",
    "test:boundary": "node scripts/boundary-e2e.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
